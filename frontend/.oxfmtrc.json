{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortTailwindcss": true,
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": ["dist/**", "node_modules/**", "src/components/ui/**", "**/*.tsbuildinfo"]
}
